{
  "name": "globe",
  "private": true,
  "version": "0.11.0",
  "description": "Atlas Globe: a detailed, colorful, installable world globe with many map filters, projections, a political timeline and a Pangea animation.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:base": "node scripts/data/build-base.mjs",
    "test:smoke": "node scripts/test/smoke.mjs",
    "test:wars": "node scripts/test/wars.mjs",
    "test:stories": "node scripts/test/stories.mjs",
    "check:data": "node scripts/data/winding.mjs --check public/data/base/*.json public/data/layers/*.json public/data/history/world_*.json public/data/paleo/*.json public/data/conflicts/*-areas.json public/data/eras/*-areas.json public/data/food/*-areas.json public/data/structures/*-areas.json public/data/people/*-areas.json public/data/life/*-areas.json public/data/games/*-areas.json public/data/regions/*.json && node scripts/data/build-conflicts.mjs --check",
    "data:conflicts": "node scripts/data/build-conflicts.mjs --kind wars",
    "data:stories": "node scripts/data/build-conflicts.mjs",
    "data:regions": "node scripts/data/build-regions.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-color": "^3.1.1",
    "d3-contour": "^4.0.3",
    "d3-geo": "^3.1.2",
    "d3-geo-polygon": "^2.0.1",
    "d3-geo-projection": "^4.0.0",
    "d3-interpolate": "^3.0.2",
    "d3-scale-chromatic": "^3.1.1",
    "lucide": "^1.68.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "flag-icons": "^7.6.0",
    "mapshaper": "^0.7.101",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
